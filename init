"use strict";

const ROOT = process.cwd();
const ENV = process.env.NODE_ENV || "development";

const config = {
  root: ROOT,
  env: ENV,
  debug: ENV !== "production",
};

const runtime = {
  bootstrapped: false,
  version: "0.0.0",
};

function mergeConfig(partial) {
  if (partial && typeof partial === "object") {
    if (partial.env != null) config.env = String(partial.env);
    if (partial.root != null) config.root = String(partial.root);
  }
  return config;
}

function bootstrap(options) {
  if (runtime.bootstrapped) return runtime;
  mergeConfig(options);
  runtime.bootstrapped = true;
  return runtime;
}

function init(options) {
  return bootstrap(options);
}

init();
